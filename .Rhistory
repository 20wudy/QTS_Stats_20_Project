# Tasks:
# 1. Create around 15 predefined news events.
# 2. Randomly release news at different intervals.
# 3. Record published headlines and timestamps.
# 4. Prevent the same headline from appearing twice in a row.
# 5. Connect news events to stock price changes.
news_events <- data.frame(
id = 1:15,
headline = c(
"Tech Giant Launches Revolutionary AI Product",
"Central Bank Announces Interest Rate Hike",
"Oil Prices Surge Due to Supply Shortage",
"Major Company Reports Record Quarterly Profits",
"Global Economic Recession Fears Rise",
"Government Announces Renewable Energy Subsidies",
"Major Bank Faces Financial Scandal",
"Tech Company Suffers Massive Data Breach",
"Central Bank Cuts Interest Rates",
"Electric Vehicle Sales Reach Record High",
"Trade War Escalates Between Major Economies",
"Pharmaceutical Company Develops Breakthrough Drug",
"Inflation Falls Below Market Expectations",
"Major Airline Reports Unexpected Losses",
"Strong Employment Report Boosts Investor Confidence"
),
sector = c(
"Technology", "Market", "Energy",
"Company", "Market", "Green Energy",
"Banking", "Technology", "Market",
"EV", "Market", "Healthcare",
"Market", "Airlines", "Market"
),
impact = c(
0.08, -0.05, 0.07,
0.10, -0.08, 0.09,
-0.10, -0.07, 0.06,
0.08, -0.06, 0.12,
0.05, -0.09, 0.04
),
stringsAsFactors = FALSE
)
